// Recursive functions.
fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

for (var i = 0; i < 10; i = i + 1) {
  print fib(i);
}
// expect: 0
// expect: 1
// expect: 1
// expect: 2
// expect: 3
// expect: 5
// expect: 8
// expect: 13
// expect: 21
// expect: 34

print fib; // expect: <fn fib>
